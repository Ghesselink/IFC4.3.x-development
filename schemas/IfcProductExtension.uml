      <ownedAttribute xmi:type="uml:Property" xmi:id="at_IfcRelSpaceBoundary2ndLevel_CorrespondingBoundary" name="CorrespondingBoundary" type="cl_IfcRelSpaceBoundary2ndLevel" association="as_IfcRelSpaceBoundary2ndLevel_CorrespondingBoundary">
